# Copy to .env.local and fill in from your Supabase project settings.
# .env.local is gitignored — never commit real values.

# Safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SERVER ONLY — bypasses all row level security. Never prefix with NEXT_PUBLIC_,
# never import into a client component, never commit.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Base URL used to build the QR code links (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000
